# Root .htaccess for cPanel hosting (public_html)
RewriteEngine On

# Rewrite extension-less requests to PHP files anywhere not covered by sub-folder rules
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [NC,L]

# Server timezone
SetEnv TZ Asia/Kolkata

# Disable directory listing
Options -Indexes

# Custom error pages
ErrorDocument 404 /index.html

# Protect sensitive files
<FilesMatch "\.(log|sql|md|txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Suggest UTF-8 and disable unsafe HTTP methods for static assets
AddDefaultCharset UTF-8
